#!/bin/sh
# bolt-greet-auth — the login gate bolt-greet runs before starting a session.
#
# Install as /usr/local/bin/bolt-greet-auth (root, 0755) and set GREET_USER
# below. Without it bolt-greet refuses every login, so a broken install
# fails shut rather than open.
#
# Two modes, matching how the bolt locker behaves after resume:
#
#   (no args)     fingerprint. The greeter runs this in the background while
#                 you type, so a touch and a typed password race each other.
#   --password    the greeter pipes the typed password on stdin.
#
# Contract either way: exit 0 ONLY when the person at the console proved who
# they are. Any other exit keeps the greeter on its menu.
#
# Locked out? [Esc] at the greeter drops to the login getty, which asks for a
# password. That is the intended fallback, not a hole: getty authenticates.
GREET_USER=CHANGEME
FP_TIMEOUT=60

if [ "$1" = "--password" ]; then
    # bolt-auth is suid root but checks the shadow entry of its REAL uid, so
    # it has to run as the user rather than as the greeter's root. stdin
    # passes straight through.
    exec runuser -u "$GREET_USER" -- /usr/local/bin/bolt-auth
fi

# fprintd-verify's exit status has varied across versions, so trust the
# result line instead. Enrol a finger first with `fprintd-enroll`.
out=$(timeout "$FP_TIMEOUT" fprintd-verify "$GREET_USER" 2>&1)
case "$out" in
    *verify-match*) exit 0 ;;
esac
exit 1
